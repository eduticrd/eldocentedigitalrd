rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth!=null;} function owner(uid){return signedIn()&&request.auth.uid==uid;} function ts(){return request.resource.data.updatedAt is timestamp;} match /usuarios/{uid} { allow get,create,update,delete: if owner(uid); allow list: if false; match /datos/{id}{allow read,write: if owner(uid);} match /cursos/{cid}{ allow read,delete: if owner(uid); allow create,update: if owner(uid)&&request.resource.data.keys().hasOnly(['centro','grado','seccion','asignatura','nivel','ciclo','ano','profesor','createdAt','updatedAt'])&&request.resource.data.asignatura is string&&ts(); match /estudiantes/{id}{allow read,delete: if owner(uid);allow create,update: if owner(uid)&&request.resource.data.keys().hasOnly(['nombre','studentId','nacimiento','tanda','curso','seccion','telefono','email','observaciones','updatedAt'])&&request.resource.data.nombre is string&&request.resource.data.nombre.size()>0&&request.resource.data.nombre.size()<=150&&ts();} match /asistencias/{fecha}{allow read,delete:if owner(uid);allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['fecha','estados','stickers','updatedAt'])&&request.resource.data.fecha==fecha&&request.resource.data.estados is map&&request.resource.data.stickers is map&&ts();} match /evaluaciones/{id}{allow read,delete:if owner(uid);allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['nombre','fecha','periodo','tipo','incluir','criterios','updatedAt'])&&request.resource.data.tipo in ['rubrica','listaCotejo','escalaValoracion','letras']&&request.resource.data.criterios is list&&ts();} match /calificaciones/{id}{allow read,delete:if owner(uid);allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['evaluacionId','notas','updatedAt'])&&request.resource.data.evaluacionId==id&&request.resource.data.notas is map&&ts();} match /diario/{fecha}{allow read,delete:if owner(uid);allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['fecha','entradas','updatedAt'])&&request.resource.data.fecha==fecha&&request.resource.data.entradas is map&&ts();} match /reflexiones/{id}{allow read,delete:if owner(uid);allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['fecha','texto','updatedAt'])&&request.resource.data.texto is string&&request.resource.data.texto.size()<=20000&&ts();} match /configuracion/{id}{allow read,write:if owner(uid);} } } match /evaluacionesPublicas/{id}{allow get:if true;allow list:if resource.data.status=='published';allow create:if signedIn()&&request.resource.data.ownerUid==request.auth.uid;allow update:if signedIn()&&resource.data.ownerUid==request.auth.uid&&request.resource.data.ownerUid==resource.data.ownerUid;allow delete:if signedIn()&&resource.data.ownerUid==request.auth.uid;match /valoraciones/{uid}{allow read:if true;allow create,update:if owner(uid)&&request.resource.data.keys().hasOnly(['valor','updatedAt'])&&request.resource.data.valor in [1,-1]&&ts();allow delete:if owner(uid);}} match /{document=**}{allow read,write:if false;} } }